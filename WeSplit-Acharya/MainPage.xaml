<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeSplit_Acharya.MainPage" BackgroundColor="White"
             Title="">

    <VerticalStackLayout>

        <Border Stroke="White"
                BackgroundColor="Green"
                Padding="10"
                Margin="0"
                HorizontalOptions="Fill"
                VerticalOptions="Start"
        >
            <StackLayout>
                <Label Text="WeSplit" FontSize="26" FontFamily="Bold" TextColor="White" HorizontalOptions="Center" />

            </StackLayout>

        </Border>

        <VerticalStackLayout Padding="10" Spacing="5">
            <Label Text="Enter total check amount:" TextColor="Black" />
            <Entry x:Name="CheckAmount" Placeholder="0.00" Keyboard="Default"/>
            <Label Text="" />

            <Label Text="Select tip percentage:" TextColor="Black" />
            <Picker x:Name="TipPicker">
                <Picker.Items>
                    <x:String>10%</x:String>
                    <x:String>15%</x:String>
                    <x:String>20%</x:String>
                    <x:String>25%</x:String>
                    <x:String>30%</x:String>
                </Picker.Items>

            </Picker>
            <Label Text="" />
            

            <Label Text="Number of People:" TextColor="Black"/>
            <Label Text="" />
            <Stepper x:Name="NumberOfPeopleStepper" Minimum="1" Maximum="1000" Increment="1" Value="1" ValueChanged="OnNumberOfPeopleChanged"  />
            <Label Text=""/>
            <Label x:Name="NumberOfPeopleSelected" Text="0 person" HorizontalOptions="Center"/>
            <Label Text=""/>

            <Button x:Name="CalculateTip" Text="Calculate" BackgroundColor="Green" HorizontalOptions="Fill" Clicked="OnCalculateTipClicked"  />

            <Label x:Name="TotalTipLabel" Text="Each person pays: $0.00" TextColor="Blue" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center"/>

        </VerticalStackLayout>


    </VerticalStackLayout>

  

</ContentPage>

