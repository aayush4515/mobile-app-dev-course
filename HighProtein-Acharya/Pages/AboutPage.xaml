<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HighProtein_Acharya.Pages.AboutPage"
             Title=""
             BackgroundColor="White">


    <!-- Toolbar Items -->

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Home"
                     IconImageSource="home.png"
                     Clicked="OnHomeClicked"
                     Order="Primary"
                     Priority="0" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Padding="0" Spacing="0">

        <Border Stroke="Teal"
                StrokeThickness="1"
                BackgroundColor="Teal"
                Padding="20"
                HorizontalOptions="Fill"
                VerticalOptions="Start"
                Margin="0" >

            <Label Text="About the App" HorizontalOptions="Center"
                   FontSize="28" FontAttributes="Bold" TextColor="White" />
        </Border>

        <ScrollView>

            <VerticalStackLayout Padding="20" Spacing="20">
                <Label Text="This coookbook was developed by its authors at the University of Alberta." FontSize="18"  />
                <Label Text="The High Protein Cookbook for Muscle Health During Cancer Treatment is Copyright by Hillary Wilson; Anissa Armet; and Carla Prado is liscened under a Creative Commons Attributions 4.0 International License, except where otherwise noted." FontSize="18" />

                <Image Source="ua_logo_green.png" Aspect="AspectFit" HorizontalOptions="Center"/>
                <Image Source="hnru.png" Aspect="AspectFit" HorizontalOptions="Center"/>
                <Image Source="prado_lab.png" Aspect="AspectFit" HorizontalOptions="Center"/>
            </VerticalStackLayout>

        </ScrollView>

    </VerticalStackLayout>


</ContentPage>
