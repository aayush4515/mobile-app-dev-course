	  <None Remove="Resources\Images\neptune.png" />
	  <None Remove="Resources\Images\planets.png" />
	  <None Remove="Resources\Images\pluto.png" />
	  <None Remove="Resources\Images\saturn.png" />
	  <None Remove="Resources\Images\uranus.png" />
	  <None Remove="Resources\Images\venus.png" />
	  <None Remove="Resources\Images\dwarf_planets_icon.png" />
	  <None Remove="Resources\Images\home_icon.png" />
	  <None Remove="Resources\Images\inner_planets_icon.png" />
	  <None Remove="Resources\Images\outer_planets_icon.png" />
	  <None Remove="Pages\" />
	  <None Remove="Pages\Inner\" />
	  <None Remove="Pages\Outer\" />
	  <None Remove="Pages\Dwarf\" />
	</ItemGroup>
	<ItemGroup>
	  <BundleResource Include="Resources\Images\ceres.png" />
	  <BundleResource Include="Resources\Images\earth.png" />
	  <BundleResource Include="Resources\Images\eris.png" />
	  <BundleResource Include="Resources\Images\haumea.png" />
	  <BundleResource Include="Resources\Images\jupiter.png" />
	  <BundleResource Include="Resources\Images\makemake.png" />
	  <BundleResource Include="Resources\Images\mars.png" />
	  <BundleResource Include="Resources\Images\mercury.png" />
	  <BundleResource Include="Resources\Images\neptune.png" />
