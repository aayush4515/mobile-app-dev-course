<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Planets.Pages.Inner.PlanetsPage"
             Title="Inner Planets">
    <VerticalStackLayout Padding="20" Spacing="20">
        <Label Text="The first four planets from the Sun are Mercury, Venus, Earth, and Mars. These inner planets also are known as terrestrial planets because they have solid surfaces." FontSize="18"
                LineBreakMode="WordWrap" />

                <Button Text="Mercury" HorizontalOptions="Fill" Clicked="OnPlanetClicked" CommandParameter="Mercury" />
                <Button Text="Venus" HorizontalOptions="Fill" Clicked="OnPlanetClicked" CommandParameter="Venus" />
                <Button Text="Earth" HorizontalOptions="Fill" Clicked="OnPlanetClicked" CommandParameter="Earth" />
                <Button Text="Mars" HorizontalOptions="Fill" Clicked="OnPlanetClicked" CommandParameter="Mars" />
    </VerticalStackLayout>
</ContentPage>
