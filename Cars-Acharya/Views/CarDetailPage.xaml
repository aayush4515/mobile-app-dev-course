<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cars_Acharya.Views.CarDetailPage"
             xmlns:converters="clr-namespace:Cars_Acharya.Converters"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Label Text="Make" />
            <Entry Text="{Binding Car.Make}" />

            <Label Text="Model" />
            <Entry Text="{Binding Car.Model}" />

            <Label Text="Year" />
            <Entry Text="{Binding Car.Year}" Keyboard="Numeric" />

            <Label Text="Price" />
            <!-- If decimal binding gives you trouble on Mac/culture, tell me and we’ll add a Decimal<->String converter -->
            <Entry Text="{Binding Car.Price}" Keyboard="Numeric" />

            <Label Text="Image URL (optional)" />
            <Entry Text="{Binding Car.ImageUrl}" />

            <Button Text="Save" Command="{Binding SaveCommand}" />

            <Button
                Text="Delete"
                Command="{Binding DeleteCommand}"
                IsEnabled="{Binding Car.Id, Converter={StaticResource IntToBoolConverter}, ConverterParameter=gt0}" />

        </VerticalStackLayout>
    </ScrollView>


</ContentPage>
