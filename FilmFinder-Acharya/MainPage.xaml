<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FilmFinder_Acharya.MainPage"
             Title="" BackgroundColor="White">

    <ScrollView>

        <VerticalStackLayout Padding="0" Spacing="0">

            <Border Stroke="SkyBlue"
                    BackgroundColor="Green"
                    Padding="10"
                    Margin="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start">

                <StackLayout>
                    <Label Text="Film Finder" TextColor="White" FontSize="24" HorizontalOptions="Center"
                       FontAttributes="Bold" />
                </StackLayout>

            </Border>

            <VerticalStackLayout Padding="15" Spacing="15">

                <Label Text="Enter the film name:" FontSize="16" TextColor="Black" HorizontalOptions="Start" VerticalOptions ="Start" />
                <Entry x:Name="FilmNameEntry" TextColor="Black" Placeholder="e.g., Inception" Keyboard="Default" />

                <Label Text="Enter the year:" FontSize="16" TextColor="Black" HorizontalOptions="Start" VerticalOptions="Start" />
                <Entry x:Name="FilmYearEntry" TextColor="Black" Placeholder="e.g., 2010" Keyboard="Numeric" />

                <Button Text="Search" HorizontalOptions="Fill" Clicked="OnSearchClicked" />

                <CollectionView ItemsSource="{Binding Films}"
                SelectionMode="Single"
                SelectionChanged="OnFilmSelected">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="10"
                                   Margin="5"
                                   CornerRadius="10"
                                   BackgroundColor="#1E1E1E">

                                <HorizontalStackLayout Spacing="12">

                                    <!-- Movie Poster -->
                                    <Image Source="{Binding Poster}"
                                           HeightRequest="120"
                                           WidthRequest="80"
                                           Aspect="AspectFill" />

                                    <!-- Movie Info -->
                                    <VerticalStackLayout Spacing="4">

                                        <Label Text="{Binding Title}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="White" />

                                        <Label Text="{Binding Year}"
                                               FontSize="14"
                                               TextColor="LightGray" />

                                        <Label Text="{Binding imdbID}"
                                               FontSize="12"
                                               TextColor="Gray" />

                                    </VerticalStackLayout>

                                </HorizontalStackLayout>

                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>

