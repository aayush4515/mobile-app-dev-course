<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FilmFinder_Acharya.FilmDetailsPage"
             Title="Film Details"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="12">

            <Image x:Name="PosterImage"
                   HeightRequest="300"
                   Aspect="AspectFit"
                   HorizontalOptions="Fill"/>

            <Label x:Name="TitleLabel"
                   TextColor="Black"
                   FontSize="22"
                   FontAttributes="Bold" />

            <Label x:Name="PlotLabel"
                   TextColor="Black"
                   FontSize="14" />

            <Label x:Name="DirectorLabel" TextColor="Black" />
            <Label x:Name="WriterLabel" TextColor="Black" />
            <Label x:Name="ActorsLabel" TextColor="Black" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
