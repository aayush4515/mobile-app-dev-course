<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MoonShot_Acharya.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MoonShot_Acharya"
    Shell.FlyoutBehavior="Disabled"
    Title="">

    <TabBar>

        <ShellContent
        Title="Home" Icon="home_icon.png"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

        <ShellContent
        Title="Artemis Missions" Icon="inner_planets_icon.png"
        ContentTemplate="{DataTemplate local:Pages.MissionsPage}"
        Route="MissionsPage" />

    </TabBar>

    

</Shell>

